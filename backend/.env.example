# NASA FIRMS API Map Key
# Obtain a free key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# NASA FIRMS Base URL
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# DuckDB Local Storage
DUCKDB_PATH=ignis_fire_warehouse.duckdb
